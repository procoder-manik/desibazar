{
  "manifest_version": 3,
  "name": "Store Product Importer",
  "short_name": "Importer",
  "version": "1.0.0",
  "description": "Import a product (name, price, description, every image) from any shop page into your store in one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Import this product",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"]
}

# ---------- core ----------
PORT=5001
NODE_ENV=development            # set to "production" on the live server
# MongoDB connection string (MongoDB Atlas recommended). Leave empty for a temporary in-memory DB.
MONGO_URI=
# 32+ random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Storefront URL(s), comma separated. The first one is where payment gateways and e-mails link back to.
CLIENT_URL=http://localhost:3000
# Public URL of this API (payment callbacks). Must be reachable from the internet in production.
API_URL=http://localhost:5001
# Set to 1 when running behind Nginx, Render, Railway or any reverse proxy (correct client IPs for rate limits).
TRUST_PROXY=
# Password for the first admin created by "npm run seed" (01700000000). Change it after signing in.
ADMIN_PASSWORD=

# ---------- e-mail (SMTP) ----------
# Gmail: smtp.gmail.com / 587 with an App Password. Also works with Zoho, Brevo, Mailgun, Hostinger mail, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ghorer Bazar <hello@yourdomain.com>"

# ---------- payments ----------
# SSLCommerz (cards, bKash, Nagad, Rocket, net banking). Sandbox: https://developer.sslcommerz.com/registration/
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_SANDBOX=true
# bKash tokenized checkout (merchant credentials from bKash)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

# ---------- courier ----------
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ---------- backups ----------
# Folder for automatic daily backups (default: backend/backups) and how many to keep.
BACKUP_DIR=
BACKUP_KEEP=14
